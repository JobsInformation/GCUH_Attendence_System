    { "source": "/login", "destination": "/api/index.py" },
    { "source": "/auth/(.*)", "destination": "/api/index.py" },
    { "source": "/students/(.*)", "destination": "/api/index.py" },
    { "source": "/lecture/(.*)", "destination": "/api/index.py" },
    { "source": "/attendance/(.*)", "destination": "/api/index.py" },
